# AURELIA local configuration. Copy to .env and adjust. No secrets required.
AURELIA_HOST=127.0.0.1
AURELIA_PORT=8484
# All filesystem tools and the SQLite DB live under this directory only.
AURELIA_DATA_DIR=./data
# Model provider on startup: echo | mini | ollama
AURELIA_DEFAULT_PROVIDER=echo
# SECURITY: the shell tool stays disabled unless you set this to true.
AURELIA_ENABLE_SHELL_TOOL=false
# Optional local Ollama runtime
AURELIA_OLLAMA_BASE_URL=http://127.0.0.1:11434
AURELIA_OLLAMA_MODEL=llama3.2
AURELIA_LOG_LEVEL=INFO
